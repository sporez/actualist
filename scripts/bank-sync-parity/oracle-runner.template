// @ts-strict-ignore
// Written into the pinned Actual checkout by scripts/bank-sync-parity/generate.mjs
// and removed after the run. Each case builds a synthetic budget through
// upstream's own db and schedule functions, loads the rules the way budget load
// does, runs upstream's reconcile path (reconcileTransactions, or
// simpleFinBatchSync for a provider download), and records the result plus the
// tables before and after.
import { readFileSync, writeFileSync } from 'node:fs';
import { expect, test, vi } from 'vitest';

import * as asyncStorage from '#platform/server/asyncStorage';
import { reconcileTransactions, simpleFinBatchSync } from '#server/accounts/sync';
import * as db from '#server/db';
import { loadMappings } from '#server/db/mappings';
import { createSchedule } from '#server/schedules/app';
import { setSyncingMode } from '#server/sync';
import { handlers } from '#server/tests/mockSyncServer';
import { insertRule, loadRules, resetState } from '#server/transactions/transaction-rules';

const plan = JSON.parse(readFileSync(__PLAN_PATH__, 'utf8'));
const contractPath = __CONTRACT_PATH__;

// reconcile runs the rules on each normalized download before matching. The input of that call is
// the post-mapping candidate (payee resolved, imported payee trimmed, notes escaped), which a replay
// takes as its own input where the provider-side mapping is not reproducible.
vi.mock('#server/transactions/transaction-rules', async importOriginal => {
  const original = await importOriginal();
  return {
    ...original,
    runRules: (transaction, accountsMap) => {
      globalThis.__bankSyncRuleInputs?.push(JSON.parse(JSON.stringify(transaction)));
      return original.runRules(transaction, accountsMap);
    },
  };
});

// Under IS_TESTING currentDay() is a constant. The first-sync Starting Balance row
// takes currentDay() when a download is empty, so the fixed day comes from the plan.
vi.mock('#shared/months', async importOriginal => {
  const original = await importOriginal();
  return { ...original, currentDay: () => globalThis.__bankSyncParityToday };
});

// Setup already records accounts, categories and schedules; the dumps carry what a call can change.
const INPUT_TABLES = ['rules', 'schedules', 'transactions'];
const AFTER_TABLES = ['accounts', 'payees', 'rules'];
// Case-independent rows the replay seeds before the case rows.
const WORLD_TABLES = ['accounts', 'category_groups', 'categories', 'category_mapping', 'payees', 'payee_mapping'];
// The post-mapping fields a replay needs; raw_synced_data and the like stay out.
const CANDIDATE_FIELDS = ['date', 'amount', 'payee', 'imported_payee', 'notes', 'category', 'imported_id', 'cleared', 'account'];
// A call changes only these account columns (balance and sync status).
const ACCOUNT_COLUMNS = new Set(['id', 'balance_current', 'balance_available', 'last_sync', 'bank_sync_status', 'tombstone']);
// Joined lookups attached for condition evaluation; not part of the transaction.
const INTERNAL_OUTPUT_FIELDS = new Set(['_account', '_account_name', '_category_name']);
// _ts is a CRDT clock; sort_order derives from the fake clock and from insertion order.
const DUMP_EXCLUDED_COLUMNS = /_ts$|^sort_order$/;
// Minted ids are id1... after the case reset; migration ids start far above.
const MINTED_ID = /^id\d{1,8}$/;

async function dumpRawTables(dumped) {
  const tables = {};
  for (const table of dumped) {
    const info = await db.all(`PRAGMA table_info(${table})`);
    if (info.length === 0) throw new Error(`Missing table ${table}`);
    const columns = info
      .map(column => column.name)
      .filter(name => !DUMP_EXCLUDED_COLUMNS.test(name))
      .filter(name => table !== 'accounts' || ACCOUNT_COLUMNS.has(name) || !narrowAccounts);
    const keys = info
      .filter(column => column.pk > 0)
      .sort((a, b) => a.pk - b.pk)
      .map(column => column.name);
    const rows = await db.all(`SELECT ${columns.join(', ')} FROM ${table}`);
    const sortValue = row => keys.map(key => String(row[key] ?? '')).join('\u0000');
    rows.sort((a, b) => (sortValue(a) < sortValue(b) ? -1 : sortValue(a) > sortValue(b) ? 1 : 0));
    tables[table] = rows.map(row => Object.fromEntries(columns.map(column => [column, row[column] ?? null])));
  }
  return tables;
}

// The public view includes deleted rows and children, with public field names.
async function dumpTransactionView() {
  const rows = await db.all('SELECT * FROM v_transactions_internal');
  const columns = rows.length > 0 ? Object.keys(rows[0]).filter(name => !DUMP_EXCLUDED_COLUMNS.test(name)) : [];
  rows.sort((a, b) => (a.id < b.id ? -1 : a.id > b.id ? 1 : 0));
  return rows.map(row => Object.fromEntries(columns.map(column => [
    column,
    column === 'date' ? db.fromDateRepr(row.date) : (row[column] ?? null),
  ])));
}

let narrowAccounts = false;

async function dumpAfter() {
  narrowAccounts = true;
  try {
    return { ...(await dumpRawTables(AFTER_TABLES)), transactions: await dumpTransactionView() };
  } finally {
    narrowAccounts = false;
  }
}

async function resetDatabase() {
  setSyncingMode('disabled');
  await global.emptyDatabase()();
  resetState();
  await loadMappings();
}

async function seedCase(world, setup, rules) {
  await resetDatabase();
  for (const account of world.accounts) {
    await db.insertAccount({
      id: account.id,
      name: account.name,
      offbudget: account.offbudget ? 1 : 0,
      closed: account.closed ? 1 : 0,
      account_id: account.providerID,
      account_sync_source: 'simpleFin',
    });
  }
  for (const group of world.groups) {
    await db.insertCategoryGroup({ id: group.id, name: group.name, is_income: group.income ? 1 : 0 });
  }
  for (const category of world.categories) {
    await db.insertCategory({
      id: category.id,
      name: category.name,
      cat_group: category.group,
      is_income: category.income ? 1 : 0,
    });
  }
  for (const payee of world.payees) {
    await db.insertPayee({ id: payee.id, name: payee.name, transfer_acct: payee.transferAccount ?? null });
  }
  for (const transaction of setup.transactions) {
    const { tombstone, ...fields } = transaction;
    await db.insertTransaction(fields);
    if (tombstone) await db.deleteTransaction({ id: transaction.id });
  }
  for (const [id, value] of Object.entries(setup.prefs)) {
    await db.update('preferences', { id, value });
  }
  for (const schedule of setup.schedules) {
    await createSchedule({
      schedule: { id: schedule.id, name: schedule.name, completed: schedule.completed ? 1 : 0 },
      conditions: schedule.conditions,
    });
    // createSchedule mints the linked rule's id; pin it so rule ranking ties are stable.
    const scheduleRow = await db.first('SELECT rule FROM schedules WHERE id = ?', [schedule.id]);
    db.runQuery('UPDATE rules SET id = ? WHERE id = ?', [schedule.ruleID, scheduleRow.rule]);
    db.runQuery('UPDATE schedules SET rule = ? WHERE id = ?', [schedule.ruleID, schedule.id]);
  }
  for (const rule of rules) {
    await insertRule({
      id: rule.id,
      stage: rule.stage,
      conditionsOp: rule.conditionsOp,
      conditions: rule.conditions,
      actions: rule.actions,
    });
  }
  // Budget load rebuilds the in-memory rules and their indexers from the table.
  await loadRules();
  // Ids minted from here on (new payees, new rows, transfer legs) restart at id1.
  global.resetRandomId();
}

// Ids minted during a case are renamed uuid-N by first appearance; setup ids are explicit.
function normalizeMintedIds(result, candidates, after) {
  const names = new Map();
  const visit = node => {
    if (typeof node === 'string' && MINTED_ID.test(node)) {
      if (!names.has(node)) names.set(node, `uuid-${names.size + 1}`);
      return names.get(node);
    }
    if (Array.isArray(node)) return node.map(visit);
    if (node !== null && typeof node === 'object') {
      return Object.fromEntries(
        Object.entries(node)
          .filter(([key]) => !INTERNAL_OUTPUT_FIELDS.has(key))
          .map(([key, value]) => [key, visit(value)]),
      );
    }
    return node;
  };
  return { result: visit(result), candidates: visit(candidates), after: visit(after) };
}

async function runCall(planned, world) {
  const transactions = JSON.parse(JSON.stringify(planned.transactions));
  if (planned.kind === 'simplefin') {
    const account = world.accounts.find(candidate => candidate.id === planned.accountId);
    // The provider download needs a user token; the test file mocks getItem the same way.
    if (typeof asyncStorage.getItem.mockResolvedValue === 'function') {
      asyncStorage.getItem.mockResolvedValue('test-token');
    } else {
      await asyncStorage.setItem('user-token', 'test-token');
    }
    handlers['/simplefin/transactions'] = () => ({
      [account.providerID]: {
        transactions: { all: transactions, booked: [], pending: [] },
        balances: [],
        startingBalance: planned.options.startingBalance ?? 0,
      },
      errors: {},
    });
    try {
      return await simpleFinBatchSync([{ id: planned.accountId, account_id: account.providerID }]);
    } finally {
      delete handlers['/simplefin/transactions'];
    }
  }
  return reconcileTransactions(planned.accountId, transactions, {
    isBankSyncAccount: planned.kind === 'bank',
    ...planned.options,
  });
}

test('bank sync parity oracle contract', async () => {
  vi.useFakeTimers({ toFake: ['Date'] });
  vi.setSystemTime(new Date(`${plan.today}T12:00:00.000Z`));
  globalThis.__bankSyncParityToday = plan.today;
  global.currentMonth = plan.today.slice(0, 7);

  await seedCase(plan.world, { transactions: [], prefs: {}, schedules: [] }, []);
  const worldTables = await dumpRawTables(WORLD_TABLES);

  const records = [];
  try {
    for (const planCase of plan.cases) {
      await seedCase(plan.world, planCase.setup, planCase.rules);
      const input = await dumpRawTables(INPUT_TABLES);
      const viewBefore = await dumpTransactionView();
      globalThis.__bankSyncRuleInputs = [];
      let result = null;
      let error = null;
      try {
        result = await runCall(planCase.call, plan.world);
      } catch (caught) {
        error = caught instanceof Error ? caught.message : String(caught);
      }
      const candidates = globalThis.__bankSyncRuleInputs.map(transaction => Object.fromEntries(
        CANDIDATE_FIELDS.filter(field => field in transaction).map(field => [field, transaction[field]]),
      ));
      const afterTables = await dumpAfter();
      const unchanged = JSON.stringify(viewBefore) === JSON.stringify(afterTables.transactions);
      const normalized = normalizeMintedIds(result, candidates, afterTables);
      records.push({
        id: planCase.id,
        source: planCase.source,
        description: planCase.description,
        seed: planCase.seed,
        oracleOnly: planCase.oracleOnly,
        tags: planCase.tags,
        setup: planCase.setup,
        rules: planCase.rules,
        call: planCase.call,
        input,
        error,
        unchanged,
        candidates: normalized.candidates,
        result: normalized.result,
        after: normalized.after,
      });
    }
  } finally {
    vi.useRealTimers();
  }
  expect(records.length).toBe(plan.cases.length);
  writeFileSync(contractPath, JSON.stringify({ worldTables, records }));
}, 1800000);
