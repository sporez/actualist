# Copy to lab.env (gitignored) and fill in your disposable lab Actual server.
#
#   cp scripts/lib/lab.example.env scripts/lib/lab.env
#
# Never commit lab.env. Environment variables already set take precedence.

: "${ACTUAL_LAB_URL:=https://actual-lab.example.invalid}"
: "${ACTUAL_LAB_PASSWORD:=change-me}"
