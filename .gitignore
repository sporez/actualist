# Local development artifacts
.artifacts/
.release/
scripts/*
!scripts/check.sh
!scripts/lint-concurrency-escape-hatches.sh
!scripts/lint-liquid-glass.sh
!scripts/lint-reference-links.sh
!scripts/lint-testflight-notes.sh
!scripts/run-ios-simulator.sh
!scripts/test.sh
# Every oracle/parity harness folder is tracked in full. Excluded: generated
# output that is ignored by the generic rules below (__pycache__, node_modules).
!scripts/*-parity/
!scripts/*-parity/**
scripts/*-parity/**/node_modules/
!scripts/parity/
!scripts/parity/**
# Disposable lab server budget tool (credentials live in ignored scripts/lib/lab.env).
!scripts/lab/
!scripts/lab/**
**/__pycache__/
*.pyc
!scripts/generate-demo-budget/
!scripts/generate-demo-budget/generate_demo_budget.py
!scripts/lib/
!scripts/lib/destinations.example.sh
!scripts/lib/lab.example.env
!scripts/lib/load-destinations.sh
!scripts/lib/testflight-notes.sh
scripts/lib/destinations.sh
scripts/lib/lab.env
.xcode-ota.yml
.xcode-ota/
.xcode-ota/builds/

# Environment files
.env
.env.*
!.env.example

# Local-only reference material
reference/

# Local pi overlay (device ids, plans, personal workflow)
.pi/
.omp/
.opencode
